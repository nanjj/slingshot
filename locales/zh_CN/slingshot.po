msgid ""
msgstr ""
"Project-Id-Version: slingshot 0.1.0\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Slingshot — AI agent tools for WeChat public accounts"
msgstr "Slingshot — 微信公众号 AI 智能体工具"

msgid "Slingshot is a CLI tool for AI agents to manage WeChat public account content."
msgstr "Slingshot 是一个供 AI 智能体管理微信公众号内容的命令行工具。"

msgid "Show help"
msgstr "显示帮助"

msgid "Show version"
msgstr "显示版本号"

msgid "Quiet mode"
msgstr "安静模式"

msgid "Error: %v\n"
msgstr "错误: %v\n"

msgid "Convert Markdown to WeChat public account HTML"
msgstr "将 Markdown 文档转换为微信公众号 HTML"

msgid "Convert a Markdown file to HTML format suitable for WeChat public accounts."
msgstr "将 Markdown 文件转换为适合微信公众号展示的 HTML 格式。"

msgid "The conversion process:\n  1. Parse the Markdown file and generate styled HTML\n  2. Extract image references from the HTML\n  3. Optionally upload images to WeChat (planned)\n  4. Save the result as <filename>.html\n"
msgstr "转换过程:\n  1. 解析 Markdown 文件并生成样式化 HTML\n  2. 提取 HTML 中的图片引用\n  3. 可选上传图片到微信 (计划中)\n  4. 将结果保存为 <filename>.html\n"

msgid "expected a file argument"
msgstr "需要一个文件参数"

msgid "Converting %s to WeChat HTML...\n"
msgstr "正在将 %s 转换为微信公众号 HTML...\n"

msgid "Done."
msgstr "完成。"

msgid "Manage WeChat drafts"
msgstr "管理微信公众号草稿"

msgid "Manage WeChat public account drafts."
msgstr "管理微信公众号草稿。"

msgid "List all drafts"
msgstr "列出所有草稿"

msgid "List all WeChat public account drafts with their IDs and titles."
msgstr "列出所有微信公众号草稿的 ID 和标题。"

msgid "Create a new draft from HTML file"
msgstr "从 HTML 文件创建草稿"

msgid "Create a new WeChat draft from an HTML file (generated by mdtowx)."
msgstr "从 HTML 文件 (由 mdtowx 生成) 创建新的微信公众号草稿。"

msgid "Update an existing draft"
msgstr "更新已有草稿"

msgid "Update an existing WeChat draft by ID with new HTML content."
msgstr "通过 ID 更新已有微信公众号草稿的 HTML 内容。"

msgid "Remove a draft"
msgstr "删除草稿"

msgid "Remove (delete) a WeChat draft by ID."
msgstr "通过 ID 删除微信公众号草稿。"

msgid "Show a draft's details"
msgstr "显示草稿详情"

msgid "Show detailed information about a WeChat draft by ID."
msgstr "通过 ID 显示微信公众号草稿的详细信息。"

msgid "Listing drafts..."
msgstr "正在获取草稿列表..."

msgid "expected id and file arguments"
msgstr "需要 id 和文件参数"

msgid "Creating draft from %s...\n"
msgstr "正在从 %s 创建草稿...\n"

msgid "Updating draft %s from %s...\n"
msgstr "正在从 %s 更新草稿 %s...\n"

msgid "expected an id argument"
msgstr "需要一个 id 参数"

msgid "Removing draft %s...\n"
msgstr "正在删除草稿 %s...\n"

msgid "Showing draft %s...\n"
msgstr "正在显示草稿 %s...\n"

# Error messages from usage package

msgid "unexpected end of argument; did you forget a suffix?"
msgstr "意外的参数结束; 是否忘记后缀?"

msgid "not enough arguments; expected a value for %s"
msgstr "参数不足; 需要为 %s 提供值"

msgid "too many arguments; unexpected %s"
msgstr "参数过多; 非预期的 %s"

msgid "unexpected %s"
msgstr "非预期的 %s"

msgid "expected %s"
msgstr "期望 %s"

msgid "unexpected %s; expected %s"
msgstr "非预期的 %s; 期望 %s"

msgid "cannot parse this argument; unexpected %s"
msgstr "无法解析此参数; 非预期的 %s"

msgid "cannot parse this argument; unexpected %s in %s"
msgstr "无法解析此参数; 在 %2$s 中发现非预期的 %1$s"

msgid "one of %s"
msgstr "其中之一 %s"

msgid "one of %s or %s"
msgstr "%s 或 %s 其中之一"

msgid ", "
msgstr "、"

msgid "Warning:"
msgstr "警告:"

msgid "(skipped: no value given)"
msgstr "(跳过: 未提供值)"

msgid "(skipped)"
msgstr "(跳过)"


msgid "Usage: %s\n"
msgstr "用法: %s\n"


# Config command translations

msgid "Manage configuration"
msgstr "管理配置"

msgid "Manage slingshot configuration file (~/.config/slingshot/config.yml)."
msgstr "管理 slingshot 配置文件 (~/.config/slingshot/config.yml)。"

msgid "List all config keys"
msgstr "列出所有配置键"

msgid "List all configuration keys and their current values."
msgstr "列出所有配置键及其当前值。"

msgid "Get a config value"
msgstr "获取配置值"

msgid "Get the value of a specific configuration key."
msgstr "获取指定配置键的值。"

msgid "Set a config value"
msgstr "设置配置值"

msgid "Set a configuration key to a new value and save."
msgstr "设置配置键为新值并保存。"

msgid "Delete a config key"
msgstr "删除配置键"

msgid "Delete a configuration key and save."
msgstr "删除配置键并保存。"

msgid "Show config file path"
msgstr "显示配置文件路径"

msgid "Print the path to the configuration file."
msgstr "打印配置文件路径。"

msgid "Edit config in editor"
msgstr "在编辑器中编辑配置"

msgid "Open the configuration file in the default editor ($EDITOR or $VISUAL)."
msgstr "在默认编辑器 ($EDITOR 或 $VISUAL) 中打开配置文件。"

msgid "expected a key argument"
msgstr "需要一个键参数"

msgid "expected key and value arguments"
msgstr "需要键和值参数"

msgid "not enough arguments"
msgstr "参数不足"

msgid "saving config"
msgstr "保存配置"

msgid "loading config"
msgstr "加载配置"

msgid "set %s = %s\n"
msgstr "已设置 %s = %s\n"

msgid "deleted %s\n"
msgstr "已删除 %s\n"
