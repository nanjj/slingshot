# Draft publish translations
msgid "Publish a draft to WeChat"
msgstr ""

msgid "Publish a draft article to your account's public timeline.\n\nBy default, this calls the FreePublish API to make the article visible\non your official account's timeline (no push notification to subscribers).\n\nTo also mass-send (群发推送) to subscribers, add --mass.\nUse --tag-id to target a specific user group instead of all subscribers.\n\nThis matches the \"发布\" behavior in the WeChat web backend, where\nmass send settings are configurable options.\n\nWithout --mass: returns publish_id for tracking via freepublish/get.\nWith --mass: also returns msg_id for tracking via masssend/get."
msgstr ""

msgid "Also mass send (群发推送) to subscribers after publishing"
msgstr ""

msgid "Mass send: msg_id: %d  msg_data_id: %d\n"
msgstr ""

