msgid "Show the full msgid and metadata for an untranslated entry.\n\nThe ID corresponds to the number shown by \"slingshot i18n check <locale>\".\nID numbering is stable — entries are sorted alphabetically.\n\nExample:\n  slingshot i18n show zh_CN 3"
msgstr "显示未翻译条目的完整 msgid 和元数据。\n\nID 对应于 \"slingshot i18n check <locale>\" 显示的数字。\nID 编号是稳定的——条目按字母顺序排序。\n\n示例：\n  slingshot i18n show zh_CN 3"

msgid "Show translation statistics for each locale.\n\nDisplays total entries, translated count, untranslated count,\nmissing entries (vs en_US), and coverage percentage."
msgstr "显示各语言环境的翻译统计。\n\n显示总条目数、已翻译数、未翻译数、\n缺失条目（相对于 en_US）和覆盖率百分比。"

msgid "Show translation statistics per locale"
msgstr "显示各语言环境的翻译统计"

msgid "Synchronize .po files with source code"
msgstr "将 .po 文件与源码同步"

msgid "Synchronize translation (.po) files with i18n.G() calls in Go source code.\n\nScans all .go files (excluding vendor/ and hidden directories) for i18n.G()\ncalls, adds new msgids to en_US, and propagates new entries to all other\nlocales with empty msgstr (untranslated).\n\nExisting translations are never overwritten.\n\nWith --delete, removes orphaned entries (msgids that exist in .po files\nbut no longer appear in source code)."
msgstr "将翻译（.po）文件与 Go 源码中的 i18n.G() 调用同步。\n\n扫描所有 .go 文件（排除 vendor/ 和隐藏目录）中的 i18n.G()\n调用，将新 msgid 添加到 en_US，并将新条目传播到所有其他\n语言环境（msgstr 为空，未翻译）。\n\n现有翻译永远不会被覆盖。\n\n使用 --delete 可删除孤立条目（存在于 .po 文件中但不再出现在源码中的 msgid）。"

